# ============================================================================
# .gitignore - Project Management Tool (PMT)
# ============================================================================

# --- Java / Maven (backend) ---
/backend/target/
/backend/*.class
/backend/.classpath
/backend/.project
/backend/.settings/
/backend/bin/

# --- Node / Angular (frontend) ---
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/*.local

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# --- OS ---
Thumbs.db
